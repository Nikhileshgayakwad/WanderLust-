<% layout("layouts/boilerplates") -%>

<!-- ================= PREPARE MAP DATA ================= -->

<%
    let coordinates = null;

    if (
        listing.geometry &&
        Array.isArray(listing.geometry.coordinates) &&
        listing.geometry.coordinates.length === 2 &&
        Number.isFinite(Number(listing.geometry.coordinates[0])) &&
        Number.isFinite(Number(listing.geometry.coordinates[1]))
    ) {
        coordinates = [
            Number(listing.geometry.coordinates[0]),
            Number(listing.geometry.coordinates[1])
        ];
    }
%>


<div class="row">

    <div class="col-8 offset-2">


        <!-- ================= LISTING TITLE ================= -->

        <h3><%= listing.title %></h3>


        <!-- ================= LISTING CARD ================= -->

        <div class="card listing-card">

            <% if (listing.image && listing.image.url) { %>

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="<%= listing.title || 'Listing image' %>"
                >

            <% } %>


            <div class="card-body">


                <!-- ================= OWNER ================= -->

                <p class="card-text">

                    <% if (listing.owner && listing.owner.username) { %>

                        <i>
                            Hosted by <%= listing.owner.username %>
                        </i>

                    <% } else { %>

                        <i>
                            Hosted by Unknown
                        </i>

                    <% } %>

                </p>


                <!-- ================= DESCRIPTION ================= -->

                <p class="card-text">

                    <%= listing.description || "No description available." %>

                </p>


                <!-- ================= PRICE ================= -->

                <p class="card-text">

                    &#8377;

                    <% if (
                        listing.price !== undefined &&
                        listing.price !== null
                    ) { %>

                        <%= Number(listing.price).toLocaleString("en-IN") %>

                    <% } else { %>

                        N/A

                    <% } %>

                </p>


                <!-- ================= LOCATION ================= -->

                <p class="card-text">

                    <b>Location:</b>

                    <%= listing.location || "Not available" %>

                </p>


                <!-- ================= COUNTRY ================= -->

                <p class="card-text">

                    <b>Country:</b>

                    <%= listing.country || "Not available" %>

                </p>


            </div>

        </div>


        <br>


        <!-- ================= MAP SECTION ================= -->

        <div class="mb-4">

            <hr>

            <h3>Where you'll be</h3>

            <div
                id="map"
                style="height: 400px; width: 100%;"
                data-coordinates='<%= JSON.stringify(coordinates) %>'
                data-maptiler-key="<%= maptilerKey || '' %>"
            ></div>

        </div>


        <!-- ================= OWNER CHECK ================= -->

        <%
            let isOwner = false;

            if (
                currUser &&
                listing.owner &&
                listing.owner._id
            ) {
                isOwner =
                    String(listing.owner._id) ===
                    String(currUser._id);
            }
        %>


        <!-- ================= EDIT / DELETE ================= -->

        <% if (isOwner) { %>

            <div class="d-flex gap-2 align-items-center mb-4">

                <a
                    href="/listings/<%= listing._id %>/edit"
                    class="btn btn-dark"
                >
                    Edit Details
                </a>


                <form
                    method="POST"
                    action="/listings/<%= listing._id %>?_method=DELETE"
                    class="m-0"
                >

                    <button
                        type="submit"
                        class="btn btn-danger"
                    >
                        Delete
                    </button>

                </form>

            </div>

        <% } %>


        <!-- ================= REVIEW FORM ================= -->

        <div class="mb-3">

            <hr>


            <% if (currUser) { %>

                <h3>Leave Review</h3>


                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation"
                >


                    <!-- ================= STAR RATING ================= -->

                    <div class="mb-3 mt-3">

                        <label class="form-label">
                            Rating
                        </label>


                        <fieldset class="starability-slot">


                            <!-- NO RATING -->

                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="0"
                                aria-label="No rating."
                            >


                            <!-- 1 STAR -->

                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                                required
                            >

                            <label
                                for="first-rate1"
                                title="Terrible"
                            >
                                1 star
                            </label>


                            <!-- 2 STAR -->

                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            >

                            <label
                                for="first-rate2"
                                title="Not good"
                            >
                                2 stars
                            </label>


                            <!-- 3 STAR -->

                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            >

                            <label
                                for="first-rate3"
                                title="Average"
                            >
                                3 stars
                            </label>


                            <!-- 4 STAR -->

                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            >

                            <label
                                for="first-rate4"
                                title="Very good"
                            >
                                4 stars
                            </label>


                            <!-- 5 STAR -->

                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            >

                            <label
                                for="first-rate5"
                                title="Amazing"
                            >
                                5 stars
                            </label>


                        </fieldset>

                    </div>


                    <!-- ================= COMMENT ================= -->

                    <div class="mb-3">

                        <label
                            for="comment"
                            class="form-label"
                        >
                            Comment
                        </label>


                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="5"
                            class="form-control"
                            placeholder="Write your review..."
                            required
                        ></textarea>


                        <div class="invalid-feedback">

                            Please enter a review before submitting.

                        </div>

                    </div>


                    <!-- ================= SUBMIT ================= -->

                    <button
                        type="submit"
                        class="btn btn-outline-dark"
                    >
                        Submit
                    </button>


                </form>


            <% } else { %>

                <p class="text-muted">

                    Please log in to leave a review.

                </p>

            <% } %>


        </div>


        <hr>


        <!-- ================= REVIEWS ================= -->

        <div class="row">


            <% if (
                !listing.reviews ||
                listing.reviews.length === 0
            ) { %>

                <p class="text-muted">

                    No reviews added yet.

                </p>


            <% } else { %>


                <% for (let review of listing.reviews) { %>


                    <div class="card col-md-5 ms-3 mb-3">


                        <div class="card-body">


                            <!-- ================= REVIEW AUTHOR ================= -->

                            <h5 class="card-title">


                                <% if (
                                    review.author &&
                                    review.author.username
                                ) { %>


                                    <%= review.author.username %>


                                <% } else { %>


                                    Anonymous


                                <% } %>


                            </h5>


                            <!-- ================= REVIEW COMMENT ================= -->

                            <p class="card-text">

                                <%= review.comment || "" %>

                            </p>


                            <!-- ================= REVIEW RATING ================= -->

                            <p
                                class="starability-result card-text"
                                data-rating="<%= review.rating || 0 %>"
                            ></p>


                            <!-- ================= REVIEW AUTHOR CHECK ================= -->

                            <%
                                let isReviewAuthor = false;

                                if (
                                    currUser &&
                                    review.author &&
                                    review.author._id
                                ) {
                                    isReviewAuthor =
                                        String(review.author._id) ===
                                        String(currUser._id);
                                }
                            %>


                            <!-- ================= DELETE REVIEW ================= -->

                            <% if (isReviewAuthor) { %>


                                <form
                                    class="mb-3"
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >


                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-dark"
                                    >
                                        Delete
                                    </button>


                                </form>


                            <% } %>


                        </div>


                    </div>


                <% } %>


            <% } %>


        </div>


    </div>

</div>


<!-- ================= MAPTILER CSS ================= -->

<link
    href="https://cdn.maptiler.com/maptiler-sdk-js/v4.1.0/maptiler-sdk.css"
    rel="stylesheet"
/>


<!-- ================= MAPTILER JS ================= -->

<script
    src="https://cdn.maptiler.com/maptiler-sdk-js/v4.1.0/maptiler-sdk.umd.min.js"
></script>


<!-- ================= MAP SCRIPT ================= -->

<script>

    const mapElement = document.getElementById("map");


    if (mapElement) {


        let listingCoordinates = null;


        try {

            listingCoordinates = JSON.parse(
                mapElement.dataset.coordinates || "null"
            );

        } catch (error) {

            console.error(
                "Invalid listing coordinates:",
                error
            );

        }


        const maptilerApiKey =
            mapElement.dataset.maptilerKey || "";


        // ================= CHECK API KEY =================

        if (!maptilerApiKey) {

            console.error(
                "MapTiler API key is missing."
            );

            mapElement.innerHTML =
                "<p class='text-muted'>Map is currently unavailable.</p>";


        }

        // ================= CHECK COORDINATES =================

        else if (
            listingCoordinates &&
            Array.isArray(listingCoordinates) &&
            listingCoordinates.length === 2 &&
            Number.isFinite(Number(listingCoordinates[0])) &&
            Number.isFinite(Number(listingCoordinates[1]))
        ) {


            // ================= SET API KEY =================

            maptilersdk.config.apiKey =
                maptilerApiKey;


            // ================= CREATE MAP =================

            const map = new maptilersdk.Map({

                container: "map",

                style:
                    maptilersdk.MapStyle.STREETS,

                center: listingCoordinates,

                zoom: 10

            });


            // ================= ADD MARKER =================

            new maptilersdk.Marker()

                .setLngLat(listingCoordinates)

                .addTo(map);


        }

        // ================= NO COORDINATES =================

        else {

            console.warn(
                "Coordinates are not available for this listing."
            );

            mapElement.innerHTML =
                "<p class='text-muted'>Location map is not available for this listing.</p>";

        }

    }

</script>